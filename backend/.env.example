# Copy to .env and fill in. NEVER commit the real .env.
PORT=8090

# Long random string — signs anti-cheat session tokens. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HMAC_SECRET=change-me-to-a-long-random-string

# Protects /admin/* (distribute, reset). Generate another random string.
ADMIN_KEY=change-me-admin-key

# Comma-separated allowed origins (your GitHub Pages site). Use * only for testing.
ALLOWED_ORIGIN=https://golputin.github.io

# Must match the game's tuning (assets/game.js: baseSpeed 17, maxSpeed 44).
MAX_SPEED=44
MAX_COINS_PER_SEC=6

# Anti-cheat run-length bounds and payout cooldown.
MIN_RUN_MS=3000
MAX_RUN_MS=7200000
COOLDOWN_HOURS=48
